# The resume itself never goes in a public repo.
*.pdf
*.docx

# The 252MB DOL workbook. Delete it after a successful ingest; the compacted
# data/sponsors.csv.gz is what we keep.
data/lca/

# Tracker exports are personal: which jobs you applied to and were rejected by.
tracker-backup*.json

.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# jsdom, installed only to run tests/page.test.js
node_modules/
package-lock.json

# Enumerated from Common Crawl locally, validated by the crawl workflow.
!data/cc_tokens.csv

# Resume content and output live in ~/.jobradar, outside this tree, and
# jobradar/resume/paths.py refuses any path that resolves inside the repo.
# These lines are the second lock, not the first.
master.yaml
lexicon.yaml
*.variant.yaml
resume-data/
resume-out/
jd-cache/
